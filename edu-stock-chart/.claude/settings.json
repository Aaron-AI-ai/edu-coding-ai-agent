{
  "permissions": {
    "allow": [
      "Bash(./gradlew test)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "echo [hook] 파일이 수정되었습니다" }
        ]
      }
    ]
  }
}
