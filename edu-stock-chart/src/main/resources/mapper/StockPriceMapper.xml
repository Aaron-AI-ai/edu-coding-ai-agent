<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.koscom.edu.stockchart.mapper.StockPriceMapper">

    <select id="findBySymbol" resultType="StockPrice">
        SELECT id, symbol, trade_date, close_price
          FROM stock_price
         WHERE symbol = #{symbol}
         ORDER BY trade_date ASC
    </select>

</mapper>
